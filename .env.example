# Sao chép file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# API key lấy ở openrouter.ai/keys (nên đặt credit limit cho key).
# Để trống = app tự chạy ở chế độ mô phỏng, không tốn tiền.
OPENROUTER_API_KEY=

# Slug model, copy từ openrouter.ai/models.
# Model BẮT BUỘC có "tools" trong supported parameters (app ép AI trả JSON qua tool call).
# Khi chỉnh prompt nên dùng model rẻ: OPENROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# true = luôn dùng kết quả mô phỏng, kể cả khi có API key
MOCK_MODE=false

# Giới hạn bảo vệ credit
MAX_CALLS_PER_HOUR=30
MAX_INPUT_CHARS=12000
MAX_OUTPUT_TOKENS=12000
